{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doxa Maps",
  "version": "0.1.0",
  "identifier": "life.doxa.maps",
  "build": {
    "frontendDist": "../../public/dx-maps",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Doxa Maps",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "url": "doxa-maps-spa/doxa-maps-spa/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ]
  }
}
